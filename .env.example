# ──────────────────────────────────────────────
# Ingestion Layer Environment Configuration
# Copy to .env and adjust for your environment
# ──────────────────────────────────────────────

# ── Redpanda ──
REDPANDA_BROKER=redpanda:9092
REDPANDA_SCHEMA_REGISTRY=http://redpanda:8081
REDPANDA_ADMIN_API=http://redpanda:9644

# Topic configuration
TOPIC_HOT=telemetry-hot
TOPIC_COLD=telemetry-cold
TOPIC_DLQ=telemetry-dlq
TOPIC_ML_FEATURES=telemetry-ml-features
TOPIC_ALERTS=alerts-critical

# Replication & partitions
REPLICATION_FACTOR=1
HOT_PARTITIONS=6
COLD_PARTITIONS=12

# ── ClickHouse ──
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_DATABASE=telemetry

# ── Flink ──
FLINK_JOBMANAGER_HOST=flink-jobmanager
FLINK_JOBMANAGER_PORT=8081
FLINK_PARALLELISM=2
FLINK_CHECKPOINT_INTERVAL_MS=60000

# ── Vector Aggregator ──
VECTOR_AGG_PORT=8686
VECTOR_AGG_GRPC_PORT=4317
VECTOR_HEALTH_PORT=8687

# ── Envoy ──
ENVOY_LISTEN_PORT=10000
ENVOY_ADMIN_PORT=9901

# ── Monitoring ──
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
ALERTMANAGER_PORT=9093

# ── Grafana ClickHouse Datasource ──
GRAFANA_CH_USER=grafana_reader
GRAFANA_CH_PASSWORD=grafana_readonly_pass

# ── TLS (set paths to your certs) ──
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
TLS_CA_PATH=./certs/ca.crt
