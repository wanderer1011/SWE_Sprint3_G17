<!-- ClickHouse Custom Configuration -->
<clickhouse>
    <logger>
        <level>information</level>
        <console>1</console>
    </logger>

    <!-- Kafka (Redpanda) integration settings -->
    <!-- clickhouse is internally converting kafka_broker_list to kafka.broker.list and giving error, commented it -->
    <!-- <kafka>
        <kafka_broker_list>redpanda:9092</kafka_broker_list>
        <group_name>clickhouse-cold-consumer</group_name>
        <auto_offset_reset>earliest</auto_offset_reset>
        <format>JSONEachRow</format>
    </kafka> -->
    <!-- <kafka>
        <bootstrap.servers>redpanda:9092</bootstrap.servers>
        <group.id>clickhouse-cold-consumer</group.id>
        <auto.offset.reset>earliest</auto.offset.reset>
    </kafka> -->

    <!-- MergeTree settings for optimized writes -->
    <merge_tree>
        <parts_to_throw_insert>300</parts_to_throw_insert>
        <max_bytes_to_merge_at_max_space_in_pool>161061273600</max_bytes_to_merge_at_max_space_in_pool>
    </merge_tree>

    <!-- Query limits to protect the cluster -->
    <max_concurrent_queries>100</max_concurrent_queries>

    <!-- Prometheus metrics endpoint -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
